{
  "name": "zapdmr",
  "productName": "ZapDMR",
  "version": "1.4.1",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "ZapDMR",
  "description": "Painel multiplataforma para TalkGroups DMR do Brasil",
  "main": "electron/main.cjs",
  "config": {
    "forge": "./electron/forge.config.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build:server && node dist/server/index.js",
    "desktop:dev": "npm run build:server && electron .",
    "package:win": "npm run build:server && electron-forge package --platform win32 --arch x64",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.8.0",
    "typescript": "^5.8.3"
  }
}
