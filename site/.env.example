NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://www.zapdmr.com.br
DATA_DIR=/var/lib/zapdmr
DOWNLOAD_DIR=/var/lib/zapdmr/downloads
# 64 hex characters, different random secrets; never commit real values.
DATA_ENCRYPTION_KEY=
DOWNLOAD_SECRET=
ADMIN_PASSWORD=
OWNER_NAME=
PRIVACY_EMAIL=
# Direct WhatsApp delivery: POST {number,text} with Authorization: Bearer TOKEN.
# Configure a private HTTPS adapter that accepts this contract and uses your provider.
# Provider credentials stay on the server; see WHATSAPP-OTP.md.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Optional reverse confirmation fallback. Receiving a trusted webhook is mandatory;
# opening wa.me or copying a displayed code alone never verifies a phone number.
# Use your real ZapDMR recipient in E.164 format and a random token >=32 characters.
WHATSAPP_CONFIRM_NUMBER=
WHATSAPP_WEBHOOK_TOKEN=
# Legacy private HTTPS delivery adapter: POST {phone,code,expiresInSeconds}.
# Used only when WHATSAPP_API_URL and WHATSAPP_API_TOKEN are both empty.
OTP_DELIVERY_URL=
OTP_DELIVERY_TOKEN=
# Production: normal verification only. No master code exists.
OTP_MODE=production
# Local demonstration only: NODE_ENV=development, PUBLIC_ORIGIN=http://localhost:3000,
# HOST=127.0.0.1 and OTP_MODE=development. Uses zapdmr-development.sqlite and marks
# whatsapp_verified=false. This mode is rejected with production or public origins.
# Default for deployments without a trusted local reverse proxy.
# With the supplied Caddyfile on the same VPS, set this to 1:
# keep HOST=127.0.0.1, block external access to the Node port, and retain
# Caddy's X-Real-IP overwrite. Otherwise all visitors share loopback rate limits.
# Do not trust a client-supplied X-Real-IP or an unverified upstream proxy chain.
TRUST_LOCAL_PROXY=0
