{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.zapdmr.com.br", "custom_domain": true },
    { "pattern": "zapdmr.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/site.js", "!/site.css", "!/ZapDMR.png"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.3.0/ZapDMR-Android-1.3.0.apk",
    "DOWNLOAD_ANDROID_BYTES": "7336566",
    "DOWNLOAD_ANDROID_SHA256": "fff4468282dad0bc4d086ffeb27e7ecce331f4cff59052c06680d0c47f189025",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.3.0/ZapDMR-Setup.exe",
    "DOWNLOAD_WINDOWS_BYTES": "160696832",
    "DOWNLOAD_WINDOWS_SHA256": "cd54d0ab2229373a2ab60956b963e085a303c15e9c69b70894871292a08aeafc",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.3.0/ZapDMR-Android-1.3.0-source.zip"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": false }
}
