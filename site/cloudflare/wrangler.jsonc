{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.zapdmr.com.br",
      "custom_domain": true
    },
    {
      "pattern": "zapdmr.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/site.js",
      "!/site.css",
      "!/ZapDMR.png"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "WHATSAPP_CONFIRM_NUMBER": "+5543996741200",
    "WHATSAPP_LOCAL_BRIDGE": "1",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.0/ZapDMR-Android-1.4.0.apk",
    "DOWNLOAD_ANDROID_BYTES": "7349012",
    "DOWNLOAD_ANDROID_SHA256": "dc47a0b6459167b243c5700a7dfb236a901ed4fefd1a016fca7a13edb4f86016",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.0/ZapDMR-Windows-1.4.0.exe",
    "DOWNLOAD_WINDOWS_BYTES": "160704512",
    "DOWNLOAD_WINDOWS_SHA256": "9b5af5c21c6837f516e3db57e90bf1a28aae339c7f57456cc17392043e33dd9e",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.0/ZapDMR-Android-1.4.0-source.zip"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
