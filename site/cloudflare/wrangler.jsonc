{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.zapdmr.com.br",
      "custom_domain": true
    },
    {
      "pattern": "zapdmr.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/site.js",
      "!/site.css",
      "!/ZapDMR.png"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "WHATSAPP_CONFIRM_NUMBER": "+5543996741200",
    "WHATSAPP_LOCAL_BRIDGE": "1",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.1/ZapDMR-Android-1.4.1.apk",
    "DOWNLOAD_ANDROID_BYTES": "7357281",
    "DOWNLOAD_ANDROID_SHA256": "5bd5b7aa6e7ad41bfd6a309ec364422ac6129d80dfb74a904d6b2340b13ce129",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.1/ZapDMR-Windows-1.4.1.exe",
    "DOWNLOAD_WINDOWS_BYTES": "160712192",
    "DOWNLOAD_WINDOWS_SHA256": "f72ae79d0b391672278dc16068026900326d5a98afb9908c54f4e40768d93e7f",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.1/ZapDMR-Android-1.4.1-source.zip"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
