{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.zapdmr.com.br",
      "custom_domain": true
    },
    {
      "pattern": "zapdmr.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/site.js",
      "!/site.css",
      "!/ZapDMR.png",
      "!/pix-zapdmr-qrcode.png"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "WHATSAPP_CONFIRM_NUMBER": "+5543996741200",
    "WHATSAPP_LOCAL_BRIDGE": "1",
    "BREVO_SENDER_EMAIL": "ativacao@auth.zapdmr.com.br",
    "BREVO_SENDER_NAME": "ZapDMR Ativação",
    "EMAIL_ACTIVATION_ENV": "experimental",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.5.6/ZapDMR-Android-1.5.6.apk",
    "DOWNLOAD_ANDROID_BYTES": "13779788",
    "DOWNLOAD_ANDROID_SHA256": "7974f7b7049878cd790483c18ca963fb86dd4ffb5fd47abcaf039453d470b8d3",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.5.6/ZapDMR-Windows-1.5.6.exe",
    "DOWNLOAD_WINDOWS_BYTES": "165372416",
    "DOWNLOAD_WINDOWS_SHA256": "99a07a14583391e9ec6afd0e5612bf814e2008c03695eb48c8c94b971fdbf500",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.5.6/ZapDMR-Windows-1.5.6-source.zip"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
