{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.zapdmr.com.br",
      "custom_domain": true
    },
    {
      "pattern": "zapdmr.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/site.js",
      "!/site.css",
      "!/ZapDMR.png"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "WHATSAPP_CONFIRM_NUMBER": "+5543996741200",
    "WHATSAPP_LOCAL_BRIDGE": "1",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.6/ZapDMR-Android-1.4.6.apk",
    "DOWNLOAD_ANDROID_BYTES": "8636362",
    "DOWNLOAD_ANDROID_SHA256": "e6a47b83b17d6eea038a1180d1fc7a1a566e97c0a72ec62465be81737ed2e2ed",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.6/ZapDMR-Windows-1.4.6.exe",
    "DOWNLOAD_WINDOWS_BYTES": "160720384",
    "DOWNLOAD_WINDOWS_SHA256": "d10bb8bbdf42dc1f50ac917c9e183b199a5575eaaa9c07f44c520710aa9650ca",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.6/ZapDMR-Android-1.4.6-source.zip"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
