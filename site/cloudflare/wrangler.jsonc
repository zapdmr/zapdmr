{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapdmr-community",
  "account_id": "affa3aa1350225291ef1a2f0139dfe10",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.zapdmr.com.br",
      "custom_domain": true
    },
    {
      "pattern": "zapdmr.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/site.js",
      "!/site.css",
      "!/ZapDMR.png"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zapdmr-community",
      "database_id": "6f272e21-de29-40a1-8bfd-801e00d2a95a"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://www.zapdmr.com.br",
    "OWNER_NAME": "Rizandro Cesar da Silva",
    "PRIVACY_EMAIL": "rizandro@gmail.com",
    "WHATSAPP_CONFIRM_NUMBER": "+5543996741200",
    "WHATSAPP_LOCAL_BRIDGE": "1",
    "DOWNLOAD_ANDROID_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.3/ZapDMR-Android-1.4.3.apk",
    "DOWNLOAD_ANDROID_BYTES": "7361377",
    "DOWNLOAD_ANDROID_SHA256": "6d2ca008ba04cd9f4aa99fd6dcb4b4cfda128cdeb49eccc6921ecb1c07f4d43c",
    "DOWNLOAD_WINDOWS_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.3/ZapDMR-Windows-1.4.3.exe",
    "DOWNLOAD_WINDOWS_BYTES": "160712704",
    "DOWNLOAD_WINDOWS_SHA256": "9b294ff136b2767d60e3cd6cc77dcbade3afb7465ca948fec5344fc9e4003266",
    "SOURCE_URL": "https://github.com/zapdmr/zapdmr/releases/download/v1.4.3/ZapDMR-Android-1.4.3-source.zip"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
